# Copy to .env.local. These stay on the server; the browser never sees them.
BACKEND_URL=http://localhost:8000
# Same value as API_ACCESS_KEY in backend/.env (leave empty if the backend has none).
BACKEND_API_KEY=

# Logins for the extension officer and MINAGRI/RAB dashboards (farmers never log in).
# AUTH_SECRET: a long random string (signs the login cookie).
# AUTH_USERS: username:password:role separated by ";" - role is extension or minagri.
AUTH_SECRET=
AUTH_USERS=officer:change-me:extension;rab:change-me-too:minagri
