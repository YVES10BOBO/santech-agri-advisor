# Copy this file to backend/.env and fill in the values.

# --- LLM provider (OpenAI-compatible) ---
# FREE option, Google Gemini (key from https://aistudio.google.com/apikey):
#   OPENAI_API_KEY=<your Gemini key>
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-2.5-flash
#   OPENAI_EMBEDDING_MODEL=gemini-embedding-001
# OpenAI option: leave LLM_BASE_URL empty and use gpt-4.1-mini / text-embedding-3-small.
OPENAI_API_KEY=sk-...
# Use the model you selected after the Kinyarwanda comparison test.
LLM_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# Set to -1 if your chosen model does not accept a temperature setting.
# Thinking before answering: low | medium | high | none (empty = provider default; low is fast)
LLM_REASONING_EFFORT=
LLM_TEMPERATURE=0.2

# --- Supabase (Project Settings > Database > Connection string, URI) ---
# Leave empty to run without a database (no RAG, in-memory sessions).
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres

# --- Security: the key C4IR will send in the X-API-Key header ---
API_ACCESS_KEY=change-me-to-a-long-random-string

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.25

# --- Frontend origins allowed to call the API ---
CORS_ORIGINS=http://localhost:3000

# --- Farmer channels: USSD + SMS via Africa's Talking (https://account.africastalking.com) ---
# Sandbox is free: AT_USERNAME=sandbox and the sandbox API key. Empty key = SMS only logged.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
# Long random text; add ?token=<this> to the USSD and SMS callback URLs in Africa's Talking.
CHANNEL_WEBHOOK_TOKEN=
